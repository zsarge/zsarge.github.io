---
export interface Props {
  panorama: string;
  id?: number;
  autoLoad?: boolean;
  options?: object;
}

const { panorama, id = 1, autoLoad = true, options = {} } = Astro.props;
const panoramaId = `panorama-${id}`;
---

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.css" />
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.js"
></script>

<style>
  .panorama {
    width: 600px;
    height: 400px;
    max-width: 100%;
  }
</style>

<div id={panoramaId} class="panorama"></div>

<script define:vars={{ panorama, autoLoad, options, panoramaId }}>
  var thePanoramaViewer = pannellum.viewer(panoramaId, {
    type: "equirectangular",
    panorama,
    autoLoad,
    ...options,
  });
</script>

