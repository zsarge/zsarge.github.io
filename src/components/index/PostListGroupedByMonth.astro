---
/**
 * This assumes that the posts are sorted beforehand.
 */

import { getCollection } from "astro:content";
import PostsList from "../../components/index/PostsList.astro";
import _ from "lodash";

const { posts } = Astro.props;

function getDateStr(date) {
  const display = date.toLocaleString('default', {
	month: 'long',
	year: 'numeric'
  });
  const sortable = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
  return JSON.stringify({ display, sortable });
}

function toKebabCase(str: string): string {
  return str
    .match(/[A-Z]?[a-z]+|[0-9]+/g)!
    .map(word => word.toLowerCase())
    .join('-');
}

const postsGroupedByMonth = _.groupBy(posts, (post) => getDateStr(post.data.pubDate));

const sortedPosts = Object.entries(postsGroupedByMonth).sort(([key1, _], [key2, __]) => {
  let date1 = JSON.parse(key1).sortable;
  let date2 = JSON.parse(key2).sortable;
  return -date1.localeCompare(date2);
});

---

<div class="space-y-4">
  {sortedPosts.map(([monthInfo, posts]) => <>
      <h2 class="text-2xl font-bold">{JSON.parse(monthInfo).display}</h2>
      <PostsList posts={posts} />
    </>
  )}
</div>
