---
import { Astro } from "astro";
import { SERVER_URL } from "../consts";

interface Props {
  image: string,
  collection?: string;
  alt?: string;
}
const { image, collection, alt } = Astro.props;

/**
 * @param {string} image
 * @param {string | undefined} collection
 * @param {"png" | "jpg" | "webp" | undefined} convertTo
 */
function getImageUrl(image, collection, convertTo) {
  const url = new URL(SERVER_URL);
  if (collection) {
    url.pathname = `/files/${collection}`;
  } else {
    url.pathname = `/files`;
  }
  url.searchParams.append("file_name", image);
  if (convertTo) {
    url.searchParams.append("convert_to", convertTo);
  } 
  return url.toString();
}

/**
 * Returns true when the file extension isn't in the filename
 */
function isNot(fileExtension) {
  return !image.includes(`.${fileExtension}`);
}

---

<picture>
  {isNot('webp') && <source srcset={getImageUrl(image, collection, "webp")} type="image/webp" /> }
  {isNot('png') && <source srcset={getImageUrl(image, collection, "png")} type="image/png" /> }
  {isNot('jpg') && <source srcset={getImageUrl(image, collection, "jpg")} type="image/jpg" /> }
  <img src={getImageUrl(image, collection)} alt={alt} />
</picture>



